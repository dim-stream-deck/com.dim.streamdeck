{
  "extends": "@tsconfig/node26/tsconfig.json",
  "compilerOptions": {
    "customConditions": ["node"],
    "resolvePackageJsonExports": true,
    "paths": {
      "@/*": ["./src/*"]
    },
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "strict": true
  },
  "include": ["src/**/*.ts", "src/types.d.ts"],
  "exclude": ["node_modules"]
}
