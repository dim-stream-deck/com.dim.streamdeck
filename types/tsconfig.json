{
  "extends": "@tsconfig/node26/tsconfig.json",
  "compilerOptions": {
    "customConditions": ["node"],
    "resolvePackageJsonExports": true,
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "strict": true
  },
  "include": ["src/*"],
  "exclude": ["node_modules"]
}
